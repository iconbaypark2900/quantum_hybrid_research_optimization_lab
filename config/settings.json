{
    "services": {
        "problem_definition_service": {
            "enabled": true,
            "host": "localhost",
            "port": 8001
        },
        "circuit_generator_service": {
            "enabled": true,
            "host": "localhost",
            "port": 8002
        },
        "execution_orchestrator_service": {
            "enabled": true,
            "host": "localhost",
            "port": 8003,
            "backends": {
                "simulator": {
                    "type": "qiskit",
                    "backend": "qasm_simulator"
                },
                "qpu": {
                    "type": "ibm_quantum",
                    "provider": "ibm_quantum",
                    "backend": "auto_select"
                }
            }
        },
        "error_mitigation_service": {
            "enabled": true,
            "techniques": ["zne", "pec", "cdr"],
            "validation_enabled": true
        },
        "hybrid_baseline_service": {
            "enabled": true,
            "classical_algorithms": [
                "milp",
                "heuristics",
                "metaheuristics",
                "machine_learning"
            ],
            "reference_metrics_enabled": true
        },
        "hpo_evolution_service": {
            "enabled": true,
            "optimization_framework": "optuna",
            "search_space": {
                "circuit_depth": {"min": 1, "max": 10},
                "learning_rate": {"min": 0.001, "max": 0.1},
                "optimizer": ["adam", "sgd", "rmsprop"]
            }
        },
        "experiment_registry_rag_service": {
            "enabled": true,
            "mlflow_tracking_uri": "sqlite:///mlruns.db",
            "indexing_enabled": true,
            "hybrid_search_enabled": true
        }
    },
    "workflows": {
        "define_problem_pipeline": {
            "enabled": true
        },
        "quantum_experiment_pipeline": {
            "enabled": true
        },
        "hpo_evolution_pipeline": {
            "enabled": true
        },
        "comparative_evaluation_pipeline": {
            "enabled": true
        }
    },
    "security": {
        "auth": "oidc_sso",
        "tenant_isolation": "project_and_namespace_level",
        "integration_with_control_plane": true
    },
    "observability": {
        "mlflow_tracking_uri": "sqlite:///mlruns.db",
        "langfuse_secret_key": "",
        "langfuse_public_key": "",
        "prometheus_endpoint": "http://localhost:9090"
    },
    "non_functional": {
        "reproducibility": true,
        "extensible_backends": true,
        "scalability": "from_single_node_to_cluster",
        "full_lineage_tracking": true
    }
}