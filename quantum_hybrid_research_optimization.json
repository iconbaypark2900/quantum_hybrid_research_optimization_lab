{
"name": "hybrid_baseline_service",
"responsibilities": [
"Run classical baselines (MILP/heuristics/ML)",
"Provide comparative metrics and optimality gaps"
]
},
{
"name": "hpo_evolution_service",
"responsibilities": [
"Use Optuna and OpenEvolve to search over circuit and optimization hyperparameters",
"Track candidate performance and maintain Pareto fronts"
]
},
{
"name": "experiment_registry_rag_service",
"responsibilities": [
"Index experiments, configs, results, and notes",
"Provide hybrid search and question-answering over prior work"
]
}
